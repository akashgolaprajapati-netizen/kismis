<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>For Twinkle ❤️</title>

<style>
body {
    margin:0;
    font-family:'Segoe UI',sans-serif;
    background:linear-gradient(135deg,#ff758c,#ff7eb3);
    overflow-x:hidden;
}

/* LOCK SCREEN */
#lockScreen {
    position:fixed;
    width:100%;
    height:100%;
    background:#ff4d6d;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    color:white;
    z-index:1000;
}

.lock-btn {
    padding:15px 25px;
    background:white;
    color:#ff4d6d;
    border-radius:20px;
    cursor:pointer;
    font-size:18px;
}

/* MAIN */
.container {
    max-width:900px;
    margin:auto;
    padding:15px;
    display:none;
}

.card {
    background:white;
    padding:25px;
    border-radius:20px;
    box-shadow:0 10px 30px rgba(0,0,0,0.2);
    margin-bottom:25px;
}

/* Typing */
.typing {
    border-right:3px solid #ff4d6d;
    white-space:nowrap;
    overflow:hidden;
    width:0;
    animation:typing 5s steps(80,end) forwards;
}
@keyframes typing {to{width:100%}}

/* Gallery */
.gallery {
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:15px;
}
.flip-inner {
    position:relative;
    height:180px;
    transform-style:preserve-3d;
    transition:0.8s;
}
.flip-card:hover .flip-inner {transform:rotateY(180deg);}
.flip-front,.flip-back {
    position:absolute;
    width:100%;height:100%;
    backface-visibility:hidden;
    border-radius:15px;
}
.flip-front img {width:100%;height:100%;border-radius:15px;}
.flip-back {
    background:#ff4d6d;
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    transform:rotateY(180deg);
}

/* Lamps */
.lamps {display:flex;justify-content:center;gap:20px;}
.lamp {font-size:40px;cursor:pointer;}
.memory-box {
    margin-top:10px;
    background:#fff3f6;
    padding:10px;
    border-radius:10px;
}

/* Chat */
.chat-box {display:flex;flex-direction:column;gap:10px;}
.message {padding:10px;border-radius:15px;max-width:70%;}
.me {background:#ff4d6d;color:white;align-self:flex-end;}
.her {background:#eee;align-self:flex-start;}

/* Voice */
.wave {
    height:5px;
    background:#ff4d6d;
    width:0%;
    transition:width 5s linear;
}

/* Floating hearts */
.heart {position:fixed;bottom:0;font-size:20px;animation:floatUp 6s linear;}
@keyframes floatUp {to{transform:translateY(-100vh);opacity:0;}}

/* Cute */
.cute {position:fixed;font-size:28px;animation:floatUp 8s linear;}

/* Flowers */
.flower {position:fixed;bottom:0;font-size:30px;animation:floatUp 5s linear;}

button {
    background:#ff4d6d;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:12px;
    cursor:pointer;
    display:block;
    margin:15px auto;
}
</style>
</head>

<body>

<!-- LOCK -->
<div id="lockScreen">
    <h2>🔐 Unlock My Heart ❤️</h2>
    <div class="lock-btn" onclick="unlock()">Tap to Unlock</div>
</div>

<!-- MAIN -->
<div class="container" id="mainContent">

<div class="card">
<div class="typing">Twinkle 💖 Viva 💖 Kishmish… I’m sorry 😔❤️</div>
<p>I promise to listen, understand, and love you better… always ❤️</p>
</div>

<!-- Gallery -->
<div class="card">
<h2>Our Memories 📸</h2>
<div class="gallery">
<!-- replace images -->
<div class="flip-card"><div class="flip-inner">
<div class="flip-front"><img src="image1.jpg"></div>
<div class="flip-back">You are my world ❤️</div>
</div></div>

<div class="flip-card"><div class="flip-inner">
<div class="flip-front"><img src="image2.jpg"></div>
<div class="flip-back">Sorry baby 😔</div>
</div></div>

<div class="flip-card"><div class="flip-inner">
<div class="flip-front"><img src="image3.jpg"></div>
<div class="flip-back">I love you 🐼</div>
</div></div>

<div class="flip-card"><div class="flip-inner">
<div class="flip-front"><img src="image4.jpg"></div>
<div class="flip-back">Forever us 💞</div>
</div></div>
</div>
</div>

<!-- Lamps -->
<div class="card">
<h2>Our Moments 🪔</h2>
<div class="lamps">
<div class="lamp" onclick="showMemory('movie')">🪔</div>
<div class="lamp" onclick="showMemory('boating')">🪔</div>
<div class="lamp" onclick="showMemory('badminton')">🪔</div>
</div>
<div id="memoryText" class="memory-box">Tap a lamp ❤️</div>
</div>

<!-- Chat -->
<div class="card">
<h2>Our Chat 💬</h2>
<div class="chat-box" id="chatBox"></div>
<button onclick="startChat()">Replay Chat</button>

<div onclick="playVoice()">🎤 Play Voice Message<div class="wave" id="wave"></div></div>
</div>

<!-- Final -->
<div class="card">
<p style="text-align:center;">
“Twinkle… Viva… Kishmish…<br>
I’m sorry… I love you forever ❤️”
</p>

<button onclick="showFlowers()">Send Flowers 💐</button>
<button onclick="startLove()">Tap My Heart 💖</button>
</div>

</div>

<script>
function unlock(){
    document.getElementById("lockScreen").style.display="none";
    document.getElementById("mainContent").style.display="block";
}

function showMemory(type){
    let t="";
    if(type=="movie") t="🎬 Watching movies with you ❤️";
    if(type=="boating") t="🚤 Boating with you ❤️";
    if(type=="badminton") t="🏸 Playing badminton ❤️";
    document.getElementById("memoryText").innerText=t;
}

function startChat(){
    let chat=document.getElementById("chatBox");
    chat.innerHTML="";
    let msgs=[
        ["Hey… listen to me", "her"],
        ["I’m sorry 🥺", "me"],
        ["You remember movies 🎬?", "her"],
        ["My favorite ❤️", "me"]
    ];
    let i=0;
    function loop(){
        if(i<msgs.length){
            let d=document.createElement("div");
            d.className="message "+msgs[i][1];
            d.innerText=msgs[i][0];
            chat.appendChild(d);
            i++;
            setTimeout(loop,1000);
        }
    }
    loop();
}

function playVoice(){
    document.getElementById("wave").style.width="100%";
    let msg=new SpeechSynthesisUtterance("I am sorry... I love you.");
    speechSynthesis.speak(msg);
}

function startLove(){
    for(let i=0;i<20;i++){
        let h=document.createElement("div");
        h.className="heart";
        h.innerHTML="❤️";
        h.style.left=Math.random()*100+"vw";
        document.body.appendChild(h);
        setTimeout(()=>h.remove(),6000);
    }
    for(let i=0;i<10;i++){
        let c=document.createElement("div");
        c.className="cute";
        c.innerHTML=["🐼","🐻"][Math.floor(Math.random()*2)];
        c.style.left=Math.random()*100+"vw";
        document.body.appendChild(c);
        setTimeout(()=>c.remove(),6000);
    }
}

function showFlowers(){
    for(let i=0;i<20;i++){
        let f=document.createElement("div");
        f.className="flower";
        f.innerHTML="🌹";
        f.style.left=Math.random()*100+"vw";
        document.body.appendChild(f);
        setTimeout(()=>f.remove(),5000);
    }
}
</script>

</body>
</html>
